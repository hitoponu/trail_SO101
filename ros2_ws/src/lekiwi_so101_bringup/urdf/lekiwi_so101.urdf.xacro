<?xml version="1.0"?>
<!--
  LeKiwi ベース + SO-101 アームの結合記述。

  ■ 接頭辞の方針
  ベースは素の名前 (prefix="")、アームだけ arm_ を付ける。
  base_link / base_footprint は REP-105 の予約名で、slam_toolbox.yaml /
  nav2.yaml / base.yaml / base_driver.py / fake_scan.yaml / nav.launch.py に
  ハードコードされている。ベース側に接頭辞を付けると 2 サブシステム 12 ファイルに
  波及するが、アーム側なら 4 ファイルで済む。

  ■ 上流マクロは prefix を「関節名にも」適用する
  したがって関節は arm_shoulder_pan_joint … arm_gripper_joint になる。
  config/ros2_controllers.yaml と launch の joint_prefix:=arm_ を必ず揃えること。

  ■ so_arm101_macro.xacro を include すること
  トップレベルの so_arm101.urdf.xacro を include すると world リンクと
  gz_ros2_control の <gazebo> ブロックまで付いてきて、ルートリンクが 2 つになる。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lekiwi_so101">

  <!-- ベース側 -->
  <xacro:arg name="use_mesh" default="false"/>
  <xacro:arg name="wheel_radius" default="0.05"/>
  <xacro:arg name="base_radius" default="0.125"/>

  <!-- アーム側。prefix / usb_port / ros2_control_hardware_type /
       ros2_control_file の 4 つは so_arm101.urdf.xacro と同名・同義にしてある。
       follower.launch.py が同じ Command 置換で単体と合成の両方を展開できる。 -->
  <xacro:arg name="prefix" default="arm_"/>
  <xacro:arg name="color" default="0.2 0.7 0.85 1.0"/>
  <xacro:arg name="usb_port" default="/dev/so101_follower"/>
  <xacro:arg name="ros2_control_hardware_type" default="real"/>
  <xacro:arg name="ros2_control_file"
             default="$(find so101_bringup)/control/so101_follower.ros2_control.xacro"/>

  <!-- ★ arm_mount_link の位置は実測済み: base_link から (0.08, 0.00, 0.057)。
       以下は arm_mount_link から見たアーム基部の姿勢。
       取付姿勢 (roll/pitch/yaw) は実測値を使用する。
       docs/agent/request.md の手順 3 でTFを照合すること。
       xacro のマクロ引数はベクトルを展開できないのでスカラ 6 個で渡す。 -->
  <xacro:arg name="arm_mount_x" default="0.0"/>
  <xacro:arg name="arm_mount_y" default="0.0"/>
  <xacro:arg name="arm_mount_z" default="0.0"/>
  <xacro:arg name="arm_mount_roll" default="0.0"/>
  <xacro:arg name="arm_mount_pitch" default="0.0"/>
  <xacro:arg name="arm_mount_yaw" default="0.0"/>

  <!-- ★ 手首カメラ (RealSense D435i)。
       取り付けは arm_gripper_link。wrist_roll と一緒に回るので、
       リーチのソルバが wrist_roll を凍結する以上ロール角は一定になる。

       ★★ 既定値は **実測値ではない**。公式 STL から幾何計算した参考値であり、
          しかも **D405 + Wrist_Roll_D405_Holder を前提とした値**。
          手元の D435i には SO-101 用の公式マウントが存在しないため、
          この値がそのまま正しくなる構成は現時点では無い。
          「0 よりマシな初期値」以上の意味を持たせないこと。

          導出の根拠と再計算手順は docs/wrist_camera.md の
          「幾何計算による参考値」節。要点だけ:
            - SO101/assets の asset と公式 STL は同一座標系 (bbox 完全一致)
            - D405 の M3 取付穴は背面 (Ø2.48 x2, 20.00mm)。光軸は取付面に垂直
            - 誤差 ±2mm / ±2 度。roll は ±180 度の曖昧さが残る
          W-5 で実測値が出たら .env で上書きし、確定したらここも差し替える。

       ★ 未実測であることに変わりはないので、TBD マーカー (マゼンタ) は残す。 -->
  <xacro:arg name="wrist_camera" default="true"/>
  <xacro:arg name="wrist_camera_name" default="wrist_camera"/>
  <xacro:arg name="wrist_camera_parent" default="gripper_link"/>
  <xacro:arg name="wrist_camera_x" default="0.0"/>
  <xacro:arg name="wrist_camera_y" default="-0.07112"/>
  <xacro:arg name="wrist_camera_z" default="-0.02074"/>
  <xacro:arg name="wrist_camera_roll" default="3.14159"/>
  <xacro:arg name="wrist_camera_pitch" default="1.04718"/>
  <xacro:arg name="wrist_camera_yaw" default="1.57080"/>

  <xacro:include filename="$(find lekiwi_description)/urdf/lekiwi_base.macro.xacro"/>
  <xacro:lekiwi_base prefix=""
                     use_mesh="$(arg use_mesh)"
                     wheel_radius="$(arg wheel_radius)"
                     base_radius="$(arg base_radius)"/>

  <xacro:include filename="$(find so_arm101_description)/urdf/so_arm101_macro.xacro"/>
  <xacro:so_arm101 prefix="$(arg prefix)"
                   color="$(arg color)"
                   parent="arm_mount_link"
                   x="$(arg arm_mount_x)"
                   y="$(arg arm_mount_y)"
                   z="$(arg arm_mount_z)"
                   roll="$(arg arm_mount_roll)"
                   pitch="$(arg arm_mount_pitch)"
                   yaw="$(arg arm_mount_yaw)"/>

  <!-- ================= 手首カメラ ================= -->
  <!--
    ★ ここが「点群を map 上に置く」ための全て。外部キャリブレーションは要らない。

      map -> ... -> ${prefix}gripper_link
                 -> wrist_camera_mount_link      (この URDF)
                 -> wrist_camera_link            (この URDF)
                 -> wrist_camera_depth_optical_frame  (realsense2_camera が /tf_static へ)

    ★ wrist_camera_link を**この URDF 側で宣言し、mount の子にする**のが要点。
      realsense2_camera は <camera_name>_link を自分のサブツリーの根として
      <name>_link -> <name>_depth_frame などを出すが、<name>_link を**子にする
      TF は出さない**。したがって親をこちらが与えても二重定義にならない。
      lekiwi_description の laser_link と同じパターン。

    ★ カメラのフレームにアームの接頭辞 (${prefix}) は付けない。
      アーム側のリンク名は上流マクロが prefix を付けるが、カメラのフレーム名は
      realsense2_camera の camera_name パラメータから作られるため。
      launch の camera_name と wrist_camera_name を必ず一致させること。
  -->
  <xacro:if value="$(arg wrist_camera)">
    <joint name="$(arg wrist_camera_name)_mount_joint" type="fixed">
      <origin xyz="$(arg wrist_camera_x) $(arg wrist_camera_y) $(arg wrist_camera_z)"
              rpy="$(arg wrist_camera_roll) $(arg wrist_camera_pitch) $(arg wrist_camera_yaw)"/>
      <parent link="$(arg prefix)$(arg wrist_camera_parent)"/>
      <child link="$(arg wrist_camera_name)_mount_link"/>
    </joint>

    <!-- TBD マーカー。RViz で取付位置が未確定だと分かるようにする。 -->
    <link name="$(arg wrist_camera_name)_mount_link">
      <visual>
        <geometry>
          <box size="0.02 0.02 0.004"/>
        </geometry>
        <material name="lekiwi_tbd"/>
      </visual>
    </link>

    <!-- D435i の筐体 (90 x 25 x 25 mm)。camera_link は筐体の中心ではなく
         左赤外イメージャ基準だが、見た目の目安として置く。 -->
    <joint name="$(arg wrist_camera_name)_link_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="$(arg wrist_camera_name)_mount_link"/>
      <child link="$(arg wrist_camera_name)_link"/>
    </joint>

    <link name="$(arg wrist_camera_name)_link">
      <visual>
        <geometry>
          <box size="0.025 0.090 0.025"/>
        </geometry>
        <material name="lekiwi_tbd"/>
      </visual>
    </link>
  </xacro:if>

  <xacro:include filename="$(arg ros2_control_file)"/>
  <xacro:ros2_control prefix="$(arg prefix)"
                      ros2_control_hardware_type="$(arg ros2_control_hardware_type)"
                      usb_port="$(arg usb_port)"/>

</robot>
