<?xml version="1.0"?>
<package format="3">
  <name>rplidar_bringup</name>
  <version>0.1.0</version>
  <description>RPLIDAR A1 launch and LaserScan to PointCloud2 conversion.</description>
  <maintainer email="maintainer@example.com">maintainer</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>laser_geometry</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
