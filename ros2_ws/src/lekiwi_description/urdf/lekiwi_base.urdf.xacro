<?xml version="1.0"?>
<!--
  LeKiwi ベースのトップレベル記述。

    xacro lekiwi_base.urdf.xacro                     # 基本図形 (既定)
    xacro lekiwi_base.urdf.xacro use_mesh:=true      # CAD メッシュ

  メッシュは meshes/ に同梱済み。車輪は 31 万面 → 2 万面へ間引いてある
  (元のままだとソフトウェアレンダリングで rviz2 が落ちる)。
  出自と再生成方法は meshes/README.md を参照。

  既定を基本図形のままにしているのは、TF を見るだけなら十分でメッシュの
  読み込みが要らないため。衝突形状は use_mesh に関わらずプリミティブ。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lekiwi">

  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_mesh" default="false"/>
  <xacro:arg name="wheel_radius" default="0.05"/>
  <xacro:arg name="base_radius" default="0.125"/>

  <xacro:include filename="$(find lekiwi_description)/urdf/lekiwi_base.macro.xacro"/>

  <xacro:lekiwi_base
      prefix="$(arg prefix)"
      use_mesh="$(arg use_mesh)"
      wheel_radius="$(arg wheel_radius)"
      base_radius="$(arg base_radius)"/>

</robot>
