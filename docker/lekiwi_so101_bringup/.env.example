# cp .env.example .env して実機に合わせて編集する。

# ★ 独自の ROS_DOMAIN_ID にしてある。
#   docker/ 以下はすべて network_mode: host なので、既定の 0 のままだと
#   同じ LAN の別スタックや別マシンと /robot_description や /tf が混信する。
#   このスタックの 4 コンテナ（ベース / LiDAR / アーム / 手首カメラ）は
#   同じドメインを共有するのが正しい。
#   防ぎたいのは「4 つ目のスタックが同じドメインに入ってくること」。
ROS_DOMAIN_ID=7
ROS_LOCALHOST_ONLY=1
# Jazzy では ROS_LOCALHOST_ONLY は非推奨で、こちらが後継。両方指定しておく。
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST

# ★ udev の安定名を使うこと。
#   /dev/ttyACM* の列挙順は運任せで、外すと 12V のホイール指令が
#   7.4V のアームサーボへ飛びうる。
#   ルールは docker/lekiwi_base_ros2/99-lekiwi.rules と
#   docker/so101_ros2/99-so101.rules。
LEKIWI_DEVICE=/dev/lekiwi
SO101_DEVICE=/dev/so101_follower
RPLIDAR_DEVICE=/dev/rplidar

# dialout グループの GID。`getent group dialout` で確認する。
DIALOUT_GID=20

# 地図の永続化先 (ホスト側)
MAP_DIR=${HOME}/maps

# RViz。実機ホストで X が無いなら 0 のままにする。
LIBGL_ALWAYS_SOFTWARE=1
# モック構成で RViz を出すか (Apple Silicon では遅いので既定 false)
MOCK_START_RVIZ=false

# ── 手首カメラ (RealSense D435i) ─────────────────────────────
# ★ camera_name は TF のフレーム名にも効く (wrist_camera_link ...)。
#   結合 URDF と compose で同じ値を使うこと。
# ★ WRIST_CAMERA は **URDF にリンクを生やすかどうかだけ**を切り替える。
#   false にしてもカメラのコンテナは止まらない。カメラを外すときは
#   `docker compose stop realsense` も併せて実行すること。
#   URDF だけ false にすると wrist_camera_link の親が無くなり、
#   TF ツリーが 2 本に割れて map -> 点群 が解けなくなる。
WRIST_CAMERA=true

# ★ この名前は TF のフレーム名にもなる (wrist_camera_link ...)。
#   変えるなら reach.rviz の PointCloud2 のトピックと
#   Axes の Reference Frame も直すこと（RViz 設定に置換の仕組みは無い）。
WRIST_CAMERA_NAME=wrist_camera

# ★ **接頭辞なしで書くこと。** URDF 側で joint_prefix (arm_) が前置される。
#   `arm_gripper_link` と書くと `arm_arm_gripper_link` を探して起動時に落ちる。
WRIST_CAMERA_PARENT=gripper_link

# 点群のレート。640x480 の点群は 1 枚 4.9MB あり、30fps では 147MB/s になる。
WRIST_CAMERA_FPS=6
WRIST_CAMERA_DECIMATION=2

# ★ 取付姿勢。arm_gripper_link から見た値。**未実測**。
#   実測したらここに書く (RViz でマゼンタのマーカーとして見える)。
#   ★ 何を測るか: wrist_camera_link は realsense の規約で**筐体の中心ではなく
#     左赤外イメージャ（左 IR レンズ）の中心**。そこまでの xyz を測ること。
#   手順は docs/wrist_camera.md。
# ★ 公式STLからの幾何計算による初期値（実測値ではない）。
#   D405 + Wrist_Roll_D405_Holder 前提なので、D435iではW-5で上書きする。
WRIST_CAMERA_X=0.0
WRIST_CAMERA_Y=-0.07112
WRIST_CAMERA_Z=-0.02074
WRIST_CAMERA_ROLL=3.14159
WRIST_CAMERA_PITCH=1.13445
WRIST_CAMERA_YAW=1.57080
