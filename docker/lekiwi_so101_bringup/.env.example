# cp .env.example .env して実機に合わせて編集する。

# ★ 独自の ROS_DOMAIN_ID にしてある。
#   docker/ 以下はすべて network_mode: host なので、既定の 0 のままだと
#   同じ LAN の別スタックや別マシンと /robot_description や /tf が混信する。
#   このスタックの 3 コンテナは同じドメインを共有するのが正しい。
#   防ぎたいのは「4 つ目のスタックが同じドメインに入ってくること」。
ROS_DOMAIN_ID=7
ROS_LOCALHOST_ONLY=1
# Jazzy では ROS_LOCALHOST_ONLY は非推奨で、こちらが後継。両方指定しておく。
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST

# ★ udev の安定名を使うこと。
#   /dev/ttyACM* の列挙順は運任せで、外すと 12V のホイール指令が
#   7.4V のアームサーボへ飛びうる。
#   ルールは docker/lekiwi_base_ros2/99-lekiwi.rules と
#   docker/so101_ros2/99-so101.rules。
LEKIWI_DEVICE=/dev/lekiwi
SO101_DEVICE=/dev/so101_follower
RPLIDAR_DEVICE=/dev/rplidar

# dialout グループの GID。`getent group dialout` で確認する。
DIALOUT_GID=20

# 地図の永続化先 (ホスト側)
MAP_DIR=${HOME}/maps

# RViz。実機ホストで X が無いなら 0 のままにする。
LIBGL_ALWAYS_SOFTWARE=1
# モック構成で RViz を出すか (Apple Silicon では遅いので既定 false)
MOCK_START_RVIZ=false

# ── 環境固定 RealSense ──────────────────────────────────────────
# ★ camera_name は TF のフレーム名にも効く (env_camera_link ...)。
ENV_CAMERA_NAME=env_camera
# 点群のレート。静止シーンなので低くてよい。
# 640x480 の点群は 1 枚 4.9MB あり、30fps では 147MB/s になる。
# 6fps + decimation 2 で約 7MB/s。
ENV_CAMERA_FPS=6
ENV_CAMERA_DECIMATION=2

# 保存済み地図の名前 (make reach-with-map で使う)。
# ★ 固定カメラの較正値は map 原点に紐づくので、SLAM で毎回地図を作り直すと
#   起動のたびに無効になる。保存地図 + amcl での運用が前提。
MAP_NAME=my_room

# ★ 較正値。env_camera_calib の出力をそのまま貼る。
#   手で書かないこと。手順は docs/env_camera_calibration.md。
#   z だけはメジャーの実測値（2D マッチングでは原理的に決まらない）。
ENV_CAMERA_X=1.5000
ENV_CAMERA_Y=0.0000
ENV_CAMERA_Z=1.0000
ENV_CAMERA_ROLL=0.0000
ENV_CAMERA_PITCH=0.4000
ENV_CAMERA_YAW=3.1416
