# LeKiwi ベースの Feetech サーボバス基板 (WaveShare) 用 udev ルール。
#
# Linux では CDC-ACM として /dev/ttyACM* に現れる。VID:PID は基板固有で
# 未確認なので、Linux ノート PC に接続して以下で確認してから書き換えること:
#
#   udevadm info --attribute-walk --name=/dev/ttyACM0 \
#     | grep -m1 -E 'idVendor|idProduct|serial'
#
# 確認した値で XXXX / XXXX を置き換えてから /etc/udev/rules.d/ へコピーする。
#
# ID_MM_DEVICE_IGNORE について:
#   ModemManager は新しく現れた CDC-ACM ポートへ数秒間 AT コマンドを送って
#   探りを入れる。これがサーボバスを壊し、症状は「接続直後だけ散発的に
#   Incorrect status packet! が出る」という分かりにくい形で現れる
#   (sts_bus.py のリトライが症状を隠してしまう)。
#   RPLIDAR の CP210x では起きにくいが CDC-ACM では頻発するため必須。

SUBSYSTEM=="tty", ATTRS{idVendor}=="XXXX", ATTRS{idProduct}=="XXXX", \
  MODE:="0660", GROUP:="dialout", SYMLINK+="lekiwi", \
  ENV{ID_MM_DEVICE_IGNORE}="1", ENV{ID_MM_PORT_IGNORE}="1"

# 同一の基板を複数繋ぐ場合は VID:PID ではなくシリアルで識別する。
# macOS でのノード名 /dev/tty.usbmodem5A7A0178741 から、この基板のシリアルは
# "5A7A0178741" と推測できる。Linux でも同じ文字列が見えるはず。
#SUBSYSTEM=="tty", ATTRS{serial}=="5A7A0178741", \
#  MODE:="0660", GROUP:="dialout", SYMLINK+="lekiwi", \
#  ENV{ID_MM_DEVICE_IGNORE}="1", ENV{ID_MM_PORT_IGNORE}="1"
