# cp .env.example .env, then adjust these values for the host.

# NOTE: mock/real の切り替えと RViz の有無は compose ではなく
#       follower.launch.py の引数で指定する。
#         ros2 launch so101_bringup follower.launch.py \
#           ros2_control_hardware_type:=real start_rviz:=false

# udev ルール導入後は /dev/so101_follower。
# mock_components のときは /dev/null のままでよい（常に存在し、開かれない）。
SO101_DEVICE=/dev/null

DIALOUT_GID=20

# ★ docker/ 以下の各構成はすべて network_mode: host なので、同じ ROS_DOMAIN_ID の
#   スタックを同時に動かすと /robot_description や /tf が衝突し、
#   RViz に別のロボットが表示される。LeKiwi ベースや RPLIDAR と併用する場合は
#   ここを変えて分離すること (0-232)。同じ LAN 上の別マシンとも混信する。
ROS_DOMAIN_ID=0
# 1: CPU software rendering (portable), 0: GPU rendering with /dev/dri passed through
LIBGL_ALWAYS_SOFTWARE=1
