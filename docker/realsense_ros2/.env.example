# cp .env.example .env, then adjust these values for the host.

# --- ROS settings ---
ROS_DOMAIN_ID=0
START_RVIZ=true

# --- Camera settings ---
# Optional: serial number to target a specific device when multiple cameras are connected.
# Leave empty to use any connected RealSense device.
CAMERA_NAME=camera
DEPTH_FPS=30
COLOR_FPS=30

# --- Display (RViz) ---
# Linux: set DISPLAY to your X server (e.g. :0 or :1)
# macOS with XQuartz: set DISPLAY=host.docker.internal:0
#   then run: xhost + 127.0.0.1
DISPLAY=:0

# 1: CPU software rendering (portable), 0: GPU rendering with /dev/dri passed through
LIBGL_ALWAYS_SOFTWARE=1
