# cp .env.example .env, then adjust these values for the host.

# --- LeKiwi ベース ---
LEKIWI_DEVICE=/dev/ttyACM0
# udev ルール (99-lekiwi.rules) を導入した場合は /dev/lekiwi を推奨
# LEKIWI_DEVICE=/dev/lekiwi

# --- RPLiDAR ---
RPLIDAR_DEVICE=/dev/ttyUSB0
# udev ルール (99-rplidar.rules) を導入した場合は /dev/rplidar を推奨
# RPLIDAR_DEVICE=/dev/rplidar
SLLIDAR_ROS2_REF=main

# --- 共通 ---
DIALOUT_GID=20
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=1
# 1: CPU ソフトウェアレンダリング(可搬性高), 0: /dev/dri を渡してGPUレンダリング
LIBGL_ALWAYS_SOFTWARE=1

# --- RViz ---
# lekiwi-base コンテナが combined.rviz で一括表示する。
# rplidar 側の RViz は compose.yaml 側で無条件に無効化済み。
LEKIWI_START_RVIZ=true

# --- lekiwi ドライラン ---
# true: シリアルを開かずに運動学・オドメトリ・TF だけ検証できる
DRY_RUN=false

# --- 地図 (compose.nav_with_map.yaml で使用) ---
# ホスト側の地図ディレクトリ。コンテナ内の /maps にマウントされる。
MAP_DIR=$HOME/maps
# 地図ファイル名 (拡張子なし)。map_saver_cli -f /maps/<この値> で保存したもの。
MAP_NAME=my_room
